# OGUN STATE LIFESTYLE — environment variables
# Copy to .env.local (local dev) and/or set in Vercel → Project → Settings → Environment Variables
# (see the Production/Preview table in README.md).
# Never commit real values. Without the Supabase values the app runs in offline guest mode.

# --- Public (safe in the browser; Row Level Security protects the data) ---
# Supabase dashboard → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New projects: the "publishable" key (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older projects only: the legacy "anon" key. Used only if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the site, used for auth email links (no trailing slash).
# Optional locally (the app falls back to the current URL).
# On Vercel: set it for PRODUCTION ONLY. Leave it UNSET for Preview, so confirmation
# links return to the preview deployment that started the sign-up.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets: NEVER prefix with NEXT_PUBLIC_, never use in client code ---
# Not needed for Phase 1/2 (nothing uses it yet). Reserved for future trusted server jobs.
# New projects: "secret" key (sb_secret_…). Older projects: SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SECRET_KEY=your-secret-key
