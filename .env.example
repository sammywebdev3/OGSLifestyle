# OGUN STATE LIFESTYLE — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Without these values the app still runs: online accounts are disabled and the
# game runs in offline guest mode (local, non-authoritative data only).

# Public — safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_ and never use in client code.
# Reserved for future trusted server jobs; Phase 1 does not need it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the public URL of the site (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
